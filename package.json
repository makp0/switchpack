{
  "name": "switchpack",
  "version": "0.3.0",
  "private": true,
  "description": "Declarative package management for Nintendo Switch homebrew and sysmodules",
  "license": "MIT",
  "repository": "github:makp0/switchpack",
  "engines": {
    "bun": ">=1.3.14"
  },
  "type": "module",
  "bin": {
    "switchpack": "./src/cli.ts"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli.ts --outfile dist/switchpack",
    "build:mtp": "bun scripts/build-mtp.ts"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "commander": "^14.0.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
